{
  "name": "goaly",
  "version": "0.2.6",
  "description": "Harness-agnostic goal-orchestration layer: run a coding agent until a frozen success criterion is verifiably met.",
  "type": "module",
  "license": "MIT",
  "author": "krimvp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krimvp/goaly.git"
  },
  "homepage": "https://github.com/krimvp/goaly#readme",
  "bugs": {
    "url": "https://github.com/krimvp/goaly/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "goaly": "dist/goaly.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "goalyrc.schema.json"
  ],
  "scripts": {
    "dev": "env -u NO_COLOR tsx src/cli/bin.ts",
    "build": "npm run gen:schema && node scripts/build.mjs && tsc -p tsconfig.build.json",
    "start": "node dist/goaly.js",
    "clean": "rm -rf dist coverage *.tgz",
    "typecheck": "tsc --noEmit",
    "check:sizes": "node scripts/check-file-sizes.mjs",
    "check:docs": "tsx scripts/check-docs-sync.ts",
    "gen:schema": "tsx scripts/gen-config-schema.ts",
    "test": "env -u NO_COLOR vitest run",
    "test:watch": "env -u NO_COLOR vitest",
    "coverage": "env -u NO_COLOR vitest run --coverage",
    "prepare": "npm run build"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.28.1",
    "happy-dom": "^20.11.2",
    "htm": "^3.1.1",
    "preact": "^10.29.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
